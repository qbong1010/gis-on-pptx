<?xml version="1.0" encoding="UTF-8"?>
<!--
  Slide Map 패널 — PowerPoint TaskPane 애드인 manifest
  * 홈 탭 오른쪽에 [Slide Map 패널] 버튼이 생기고, 누르면 우측 작업창이 열린다.
  * 지도 박스(manifest.xml, ContentApp)와는 별개의 애드인이며 메시지로 통신한다.
-->
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xmlns:ov="http://schemas.microsoft.com/office/taskpaneappversionoverrides"
  xsi:type="TaskPaneApp">

  <Id>55565cbb-3a80-4456-8e3a-6ee14e5f39b1</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>Dohwa Urban Planning</ProviderName>
  <DefaultLocale>ko-KR</DefaultLocale>
  <DisplayName DefaultValue="Slide Map 패널" />
  <Description DefaultValue="슬라이드의 Slide Map 지도 박스를 관리하는 패널 (레이어, 배경지도, API 키, Bake)" />
  <IconUrl DefaultValue="https://localhost:3000/assets/icon-32.png" />
  <HighResolutionIconUrl DefaultValue="https://localhost:3000/assets/icon-64.png" />
  <SupportUrl DefaultValue="https://localhost:3000/" />

  <AppDomains>
    <AppDomain>https://localhost:3000</AppDomain>
  </AppDomains>

  <Hosts>
    <Host Name="Presentation" />
  </Hosts>

  <DefaultSettings>
    <SourceLocation DefaultValue="https://localhost:3000/taskpane.html" />
  </DefaultSettings>

  <Permissions>ReadWriteDocument</Permissions>

  <VersionOverrides xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Hosts>
      <Host xsi:type="Presentation">
        <DesktopFormFactor>
          <FunctionFile resid="Commands.Url" />
          <ExtensionPoint xsi:type="PrimaryCommandSurface">
            <OfficeTab id="TabHome">
              <Group id="SlideMap.Group">
                <Label resid="Group.Label" />
                <Icon>
                  <bt:Image size="16" resid="Icon.16" />
                  <bt:Image size="32" resid="Icon.32" />
                  <bt:Image size="80" resid="Icon.80" />
                </Icon>
                <Control xsi:type="Button" id="SlideMap.PaneButton">
                  <Label resid="PaneButton.Label" />
                  <Supertip>
                    <Title resid="PaneButton.Label" />
                    <Description resid="PaneButton.Tooltip" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16" />
                    <bt:Image size="32" resid="Icon.32" />
                    <bt:Image size="80" resid="Icon.80" />
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>SlideMapPane</TaskpaneId>
                    <SourceLocation resid="Taskpane.Url" />
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>
    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16" DefaultValue="https://localhost:3000/assets/icon-16.png" />
        <bt:Image id="Icon.32" DefaultValue="https://localhost:3000/assets/icon-32.png" />
        <bt:Image id="Icon.80" DefaultValue="https://localhost:3000/assets/icon-80.png" />
      </bt:Images>
      <bt:Urls>
        <bt:Url id="Commands.Url" DefaultValue="https://localhost:3000/commands.html" />
        <bt:Url id="Taskpane.Url" DefaultValue="https://localhost:3000/taskpane.html" />
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="Group.Label" DefaultValue="Slide Map" />
        <bt:String id="PaneButton.Label" DefaultValue="Slide Map 패널" />
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="PaneButton.Tooltip" DefaultValue="지도 박스의 레이어·배경지도·API 키를 관리하고 슬라이드에 정착합니다." />
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
