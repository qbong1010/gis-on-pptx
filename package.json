{
  "name": "gis-on-pptx",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/qbong1010/gis-on-pptx.git"
  },
  "type": "module",
  "scripts": {
    "certs": "office-addin-dev-certs install",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "sideload": "office-addin-debugging start manifest-taskpane.xml desktop --app powerpoint --dev-server \"npm run dev\" --dev-server-port 3000",
    "sideload:stop": "office-addin-debugging stop manifest-taskpane.xml desktop --app powerpoint",
    "validate": "office-addin-manifest validate manifest-taskpane.xml",
    "register": "office-addin-dev-settings register manifest-taskpane.xml",
    "unregister": "office-addin-dev-settings unregister manifest-taskpane.xml",
    "nodebug": "office-addin-dev-settings debugging manifest-taskpane.xml --disable",
    "registered": "office-addin-dev-settings registered"
  },
  "dependencies": {
    "@mapbox/vector-tile": "^3.0.0",
    "@turf/turf": "^7.4.0",
    "but-unzip": "^0.1.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dxf-parser": "^1.1.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.73.0",
    "pbf": "^5.1.2",
    "proj4": "^2.23.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shpjs": "^6.2.0",
    "sql.js": "^1.16.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.6",
    "@types/office-js": "^1.0.617",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^6.3.0",
    "office-addin-debugging": "^7.0.1",
    "office-addin-dev-certs": "^3.0.1",
    "office-addin-manifest": "^3.0.1",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.9.3",
    "vite": "^8.3.8"
  }
}
